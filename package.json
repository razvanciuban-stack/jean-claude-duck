{
  "name": "jean-claude-duck",
  "version": "0.2.0",
  "description": "Mysthi — a black cat desktop pet that quietly learns how you work",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/",
    "build": "npm run build:helper && electron-builder --mac",
    "build:helper": "swift build -c release --package-path native/mysthi-helper",
    "build:dmg": "npm run build:helper && electron-builder --mac dmg",
    "eval:chat": "node scripts/chat-eval.js"
  },
  "build": {
    "productName": "Mysthi",
    "appId": "com.jeanclaude.duck",
    "mac": {
      "category": "public.app-category.entertainment",
      "icon": "assets/icon.icns",
      "target": [
        "dmg"
      ],
      "identity": "Mysthi Local Signing",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Mysthi checks which app is in front so she knows what you are working on."
      },
      "binaries": [
        "Contents/Resources/mysthi-helper"
      ]
    },
    "dmg": {
      "title": "Mysthi",
      "iconSize": 80,
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "files": [
      "main.js",
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "native/mysthi-helper/.build/release/mysthi-helper",
        "to": "mysthi-helper"
      }
    ]
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-store": "^8.2.0"
  }
}
