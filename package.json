{
  "name": "jean-claude-duck",
  "version": "0.2.0",
  "description": "Jean Claude Duck — AI-powered pixel-art rubber duck desktop pet",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/",
    "build": "electron-builder --mac",
    "build:helper": "swift build -c release --package-path native/mysthi-helper",
    "build:dmg": "electron-builder --mac dmg"
  },
  "build": {
    "productName": "Jean Claude Duck",
    "appId": "com.jeanclaude.duck",
    "mac": {
      "category": "public.app-category.entertainment",
      "icon": "assets/icon.icns",
      "target": [
        "dmg"
      ]
    },
    "dmg": {
      "title": "Jean Claude Duck",
      "iconSize": 80,
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "files": [
      "main.js",
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ]
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "electron-store": "^8.2.0"
  }
}
